<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.tekin</groupId>
    <artifactId>selenium-cucumber-demo</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- extra JVM options for the Surefire fork, e.g. -Dtest.jvm.args=-Xmx64m -->
        <test.jvm.args></test.jvm.args>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>4.34.0</version>
        </dependency>

        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>6.1.0</version>
        </dependency>

        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>7.23.0</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit</artifactId>
            <version>7.23.0</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <argLine>-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 ${test.jvm.args}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
        Failure scenario profiles (see SCENARIOS.md). Each one reproduces a real-world
        Maven/Java build failure; the Jenkinsfile activates them through the SCENARIO parameter.
    -->
    <profiles>

        <!-- MVN_DEPENDENCY_NOT_FOUND: internal library that was never published to the repository -->
        <profile>
            <id>mvn-dependency-not-found</id>
            <dependencies>
                <dependency>
                    <groupId>com.tekin.qa</groupId>
                    <artifactId>qa-test-commons</artifactId>
                    <version>2.4.1</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>

        <!-- MVN_COMPILATION_ERROR: adds a test source folder whose code uses a renamed page-object method -->
        <profile>
            <id>mvn-compilation-error</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>add-checkout-steps</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/scenarios/compile-error/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- JAVA_RELEASE_NOT_SUPPORTED: project targets a Java release the agent's JDK does not know -->
        <profile>
            <id>java-release-not-supported</id>
            <properties>
                <maven.compiler.release>30</maven.compiler.release>
            </properties>
        </profile>

    </profiles>

</project>
